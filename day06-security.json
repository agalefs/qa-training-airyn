        {
          "name": "POST Return Late Rental for SEC-06",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Return succeeds and applies a late fee > 0', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "",
                  "    const body = pm.response.json();",
                  "    const rental = body.rental || body;",
                  "    const status = rental.status || body.status;",
                  "    const lateFee =",
                  "        rental.lateFee ??",
                  "        rental.late_fee ??",
                  "        body.lateFee ??",
                  "        body.late_fee ??",
                  "        0;",
                  "",
                  "    if (status) {",
                  "        pm.expect(String(status).toLowerCase()).to.equal('returned');",
                  "    }",
                  "",
                  "    pm.expect(Number(lateFee)).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
